# =============================================================================
#  XAU Trading Bot - configuration
#
#  Copy this file to .env and fill in your values. setup.bat does that for you.
#  .env holds real credentials - never share it, never commit it.
# =============================================================================

# --- MetaTrader 5 account ----------------------------------------------------
# All three come from MT5: File > Login to Trade Account, or the "Login" line
# in the Navigator. The server string must match exactly, including the
# -Demo / -MT5Trial suffix, or the connection is refused.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- LLM provider ------------------------------------------------------------
# Any OpenAI-compatible endpoint. The decision step needs a real model; without
# one the bot writes SKIP to signal.json and never trades, without printing an
# error. That silence is the most common way for this thing to look installed
# and do nothing.
#
# Pick one:
#
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1
#               LLM_MODEL=gpt-4o-mini
#
#   DeepSeek    LLM_BASE_URL=https://api.deepseek.com/v1
#               LLM_MODEL=deepseek-chat
#               (NOT deepseek-reasoner — it thinks for minutes and the call
#                times out at 40s, so it would never produce a signal)
#
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#               LLM_MODEL=llama-3.3-70b-versatile
#               (free tier, very fast, good enough for this)
#
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1
#               LLM_API_KEY=ollama        <- any text works, it is not checked
#               LLM_MODEL=llama3.2
#               (runs on your own machine, no cost, no key, needs 8GB+ RAM)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Fallback provider -------------------------------------------------------
# Optional but recommended. If the primary endpoint is down, rate-limiting, or
# timing out, the bot retries here instead of writing SKIP and doing nothing.
#
# Set a DIFFERENT provider. Pointing this at the same URL and model as the
# primary is not a fallback — it is a second attempt at the thing that just
# failed, and the bot will not treat it as one.
#
# A free local Ollama instance makes a good second pair: different endpoint,
# no cost, survives the internet going down.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Telegram notifications --------------------------------------------------
# Optional. Leave blank and no notifications are sent. To enable: talk to
# @BotFather, create a bot, get the token, then message the bot once and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
