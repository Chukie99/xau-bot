# =============================================================================
#  XAU Trading Bot - configuration
#
#  Copy this file to .env and fill in your values. setup.bat does that for you.
#  .env holds real credentials - never share it, never commit it.
# =============================================================================

# --- MetaTrader 5 account ----------------------------------------------------
# All three come from MT5: File > Login to Trade Account, or the "Login" line
# in the Navigator. The server string must match exactly, including the
# -Demo / -MT5Trial suffix, or the connection is refused.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- LLM provider ------------------------------------------------------------
# Any OpenAI-compatible endpoint. Two common setups:
#
#   Local gateway:  LLM_BASE_URL=http://localhost:20128/v1
#   Cloud provider: LLM_BASE_URL=https://api.openai.com/v1
#
# LLM_API_KEY is your key for whichever provider you pick. The decision step
# needs a real model - without it the bot writes SKIP to signal.json and never
# trades, without printing an error. That silence is the most common way for
# this thing to look installed and do nothing.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=gemini/gemini-3.5-flash-lite

# --- Telegram notifications --------------------------------------------------
# Optional. Leave blank and no notifications are sent. To enable: talk to
# @BotFather, create a bot, get the token, then message the bot once and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
